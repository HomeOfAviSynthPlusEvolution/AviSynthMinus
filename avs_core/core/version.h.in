#ifndef _AVS_VERSION_H_
#define _AVS_VERSION_H_

#include "arch.h"

#define       AVS_PPSTR_(x)    	#x
#define       AVS_PPSTR(x)    	AVS_PPSTR_(x)

#define       AVS_PROJECT       AviSynth-
#define       AVS_MAJOR_VER     3
#define       AVS_MINOR_VER     7
#define       AVS_BUGFIX_VER    5
#define       AVS_MINUS_MAJOR_VER  0
#define       AVS_MINUS_MINOR_VER  2
#define       AVS_MINUS_BUGFIX_VER 1
#define       AVS_MINUS_VERSION "@AVS_MINUS_VERSION@"
#define       AVS_MINUS_FILEVERSION @AVS_MINUS_FILEVERSION@
#define       AVS_DEV_REVDATE   @AVS_DEV_REVDATE@
// Upstream v3.7.5 compatibility baseline, not the fork's commit count.
#define       AVS_SEQREV        4289
#define       AVS_FULLVERSION	AVS_PPSTR(AVS_PROJECT) " " AVS_MINUS_VERSION " (" AVS_PPSTR(AVS_ARCH) ") [Like AviSynth+ " AVS_PPSTR(AVS_MAJOR_VER) "." AVS_PPSTR(AVS_MINOR_VER) "." AVS_PPSTR(AVS_BUGFIX_VER) "]"

#endif  //  _AVS_VERSION_H_
